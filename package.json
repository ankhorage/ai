  },
  "scripts": {
    "build": "bunx tsc -p tsconfig.build.json",
    "check-types": "bunx tsc --noEmit -p tsconfig.json",
    "typecheck": "bun run check-types",
    "test": "bun test",
    "lint": "ankhorage-eslint . --max-warnings=0",
    "knip:check": "ankhorage-knip",
    "format": "ankhorage-prettier --write .",
    "format:check": "ankhorage-prettier --check .",
    "changeset": "ankhorage-changeset",
    "changeset:status": "ankhorage-changeset status --since=origin/main",
    "docs": "bunx @ankhorage/paradox",
    "version-packages": "ankhorage-changeset version"
  },
  "dependencies": {
    "@ankhorage/project-detector": "^0.3.5",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@ankhorage/ankh": "^0.13.3"
  },
  "devDependencies": {
    "@ankhorage/ankh": "^0.13.3",
    "@ankhorage/devtools": "^2.4.1",
    "@ankhorage/paradox": "^0.3.6",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.4.2"
}
