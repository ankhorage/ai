{
  "name": "@ankhorage/ai",
  "version": "0.1.0",
  "description": "Provider-aware agentic development setup and workflows for Ankhorage projects.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/ankhorage/ai#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhorage/ai.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "ankhorage-ai": "./dist/cli/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs"
  ],
  "ankh": {
    "category": "ai",
    "provider": "./dist/cli/index.js",
    "capabilities": [
      {
        "id": "ai.init",
        "owner": "@ankhorage/ai",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "AI init",
        "description": "Ankhorage AI init command"
      },
      {
        "id": "ai.sync",
        "owner": "@ankhorage/ai",
        "access": [
          "invoke"
        ],
        "binding": {
